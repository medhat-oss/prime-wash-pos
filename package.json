{
  "name": "car-wash-erp-pos",
  "version": "1.0.0",
  "description": "Car Wash ERP & POS with BOM, Inventory in grams, Orders, and Payroll management",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev\" \"npm run client:dev\"",
    "build:all": "npm run build && npm run client:build",
    "deploy:pages": "npm run client:build && npx wrangler pages deploy client/dist --project-name prime-wash-pos --branch main",
    "deploy:worker": "wrangler deploy",
    "db:test": "tsx src/db/test-connection.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/migrate.ts && tsx src/db/seed.ts",
    "seed:clean": "tsx src/scripts/seed-clean-data.ts",
    "db:cleanup-duplicates": "tsx src/scripts/cleanup-test-duplicates.ts",
    "test:api": "tsx src/scripts/test-api.ts",
    "test:sanity": "tsx test-e2e-sanity.ts",
    "test:edge-cases": "tsx test-edge-cases.ts",
    "test:perf-thermal": "tsx test-performance-thermal.ts"
  },
  "keywords": [
    "car-wash",
    "erp",
    "pos",
    "postgresql",
    "neon",
    "bom",
    "inventory",
    "payroll",
    "react",
    "tailwind"
  ],
  "author": "",
  "license": "ISC",
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "multer": "^2.2.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.11",
    "concurrently": "^9.2.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "wrangler": "^4.125.0"
  }
}
