# PostgreSQL Connection URL (Neon or Local)
DATABASE_URL=postgresql://username:password@ep-sample-123456.us-east-1.aws.neon.tech/neondb?sslmode=require

# Application Port & Environment
PORT=3000
NODE_ENV=development

# Admin Security PIN (Required for HR, Payroll, Tax & Settings)
ADMIN_PIN=1234

# CORS Allowed Origins (Comma-separated or specific frontend domain)
CORS_ORIGIN=http://localhost:5173

# Cloudinary Media Storage (Optional: if omitted, uploads will be stored locally in /uploads/media)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


